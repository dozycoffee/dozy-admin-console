# 업무 API(dozy-wms-api)
VITE_API_BASE_URL=http://localhost:8080
# 인증 서비스(dozy-auth). refresh 쿠키를 주고받으므로 auth 서버의 AUTH_CORS_ALLOWED_ORIGINS에 이 콘솔의 origin이 있어야 한다.
VITE_AUTH_BASE_URL=http://localhost:8081
# 창고 관련 모드(창고 관리자, 본사 재고 담당자)를 가진 사용자의 AccessScope. 쉼표로 구분한 dozy-wms-api 창고 id.
# auth에는 창고 개념이 없고 창고 목록·담당 창고 API도 아직 없어 임시로 환경 설정으로 지정한다.
VITE_WAREHOUSE_IDS=543
# 상품 서비스(dozy-catalog-api). Bearer 토큰만 쓰므로 쿠키는 보내지 않는다. catalog 서버의 CATALOG_CORS_ALLOWED_ORIGINS에 이 콘솔의 origin이 있어야 한다.
VITE_CATALOG_BASE_URL=http://localhost:8082
# true면 개발 서버(npm run dev)에서 dozy-auth 로그인과 dozy-catalog-api 조회를 MSW 목으로 응답한다. 실서버 없이 MD 상품 화면을 볼 때만 쓴다.
# VITE_MOCK_CATALOG=true
