# 업무 API(dozy-wms-api)
VITE_API_BASE_URL=http://localhost:8080
# 인증 서비스(dozy-auth). refresh 쿠키를 주고받으므로 auth 서버의 AUTH_CORS_ALLOWED_ORIGINS에 이 콘솔의 origin이 있어야 한다.
VITE_AUTH_BASE_URL=http://localhost:8081
# 재고 서비스(dozy-inventory-api). 브라우저가 직접 호출하므로 inventory 서버의 CORS_ALLOWED_ORIGINS에 이 콘솔의 origin이 있어야 한다.
VITE_INVENTORY_BASE_URL=http://localhost:8082
# 창고 관련 모드(창고 관리자)를 가진 사용자의 AccessScope. 쉼표로 구분한 dozy-wms-api 창고 id.
# auth에는 창고 개념이 없고 창고 목록·담당 창고 API도 아직 없어 임시로 환경 설정으로 지정한다.
VITE_WAREHOUSE_IDS=543
